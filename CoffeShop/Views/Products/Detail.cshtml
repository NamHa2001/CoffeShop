@model CoffeShop.Models.Product
@{
    ViewData["Title"] = "Chi tiết sản phẩm";
}

<a class="btn btn-secondary mb-3" asp-controller="Products" asp-action="GetAll">
    ← Trở về danh sách
</a>
<h1>Thông tin chi tiết sản phẩm</h1>
<hr />

<div class="container">
    <div class="row">
        <div class="col-sm-3">
            <img src="@Model.ImageUrl" class="img-thumbnail float-left" />
        </div>
        <div class="col-sm-9">
            <p><span class="fw-bold">Tên sản phẩm:</span> @Model.Name</p>
            <p><span class="fw-bold">Giá:</span> @Model.Price.ToString("C")</p>
            <p><span class="fw-bold">Mô tả:</span> @Model.Detail</p>
            <p>
                <span class="fw-bold">Nổi bật:</span>
                @if (Model.IsTrendingProduct)
                {
                    <span class="badge bg-warning text-dark">Sản phẩm nổi bật</span>
                }
                else
                {
                    <span>Không</span>
                }
            </p>

            @if (User.IsInRole("Admin") || User.IsInRole("Editor"))
            {
                <a class="btn btn-warning" href="/Products/Edit/@Model.Id">Chỉnh sửa</a>
            }
            @if (User.IsInRole("Admin"))
            {
                <a class="btn btn-danger ms-2" href="/Products/Delete/@Model.Id">Xóa</a>
            }
        </div>
    </div>
</div>
