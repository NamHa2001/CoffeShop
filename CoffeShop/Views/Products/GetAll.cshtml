@model IEnumerable<CoffeShop.Models.Product>
@{
    ViewData["Title"] = "Quản lý sản phẩm";
    var i = 1;
    var successMessage = TempData["successMessage"]?.ToString();
    var errorMessage = TempData["errorMessage"]?.ToString();
}

@if (!string.IsNullOrWhiteSpace(successMessage))
{
    <div class="alert alert-success">@successMessage</div>
}
else if (!string.IsNullOrWhiteSpace(errorMessage))
{
    <div class="alert alert-danger">@errorMessage</div>
}

<h1>DANH SÁCH SẢN PHẨM</h1>

@using (Html.BeginForm())
{
    <p class="mt-3">
        Tìm kiếm: @Html.TextBox("searchString", null, new { @class = "form-control d-inline w-25" })
        @Html.RadioButton("type", "Name") <label class="me-2">Theo tên</label>
        @Html.RadioButton("type", "Detail") <label class="me-3">Theo mô tả</label>
        <input type="submit" value="Tìm kiếm" class="btn btn-secondary" />
    </p>
}

<table class="table table-bordered table-hover mt-2">
    <thead class="table-dark text-center">
        <tr>
            <th>STT</th>
            <th>Tên sản phẩm</th>
            <th>Giá</th>
            <th>Nổi bật</th>
            <th>Hình ảnh</th>
            <th>Chi tiết</th>
            <th>Chỉnh sửa</th>
            <th>Xóa</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr class="text-center align-middle">
                <td>@i</td>
                <td>@item.Name</td>
                <td>@item.Price.ToString("C")</td>
                <td>@(item.IsTrendingProduct ? "✔" : "")</td>
                <td><img src="@item.ImageUrl" height="60" /></td>
                <td><a class="btn btn-info btn-sm" href="~/Products/Detail/@item.Id">Chi tiết</a></td>
                <td>
                    @if (User.IsInRole("Admin") || User.IsInRole("Editor"))
                    {
                        <a class="btn btn-warning btn-sm" href="~/Products/Edit/@item.Id">Sửa</a>
                    }
                </td>
                <td>
                    @if (User.IsInRole("Admin"))
                    {
                        <a class="btn btn-danger btn-sm" href="~/Products/Delete/@item.Id">Xóa</a>
                    }
                </td>
            </tr>
            i++;
        }
    </tbody>
</table>

@if (User.IsInRole("Admin") || User.IsInRole("Editor"))
{
    <a class="btn btn-primary mt-2" href="~/Products/Add">+ Thêm sản phẩm</a>
}
