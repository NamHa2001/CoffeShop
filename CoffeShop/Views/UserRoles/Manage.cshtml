@model List<CoffeShop.Models.User.ManageUserRolesVM>
@{
    ViewData["Title"] = "Chỉnh sửa quyền";
}

<form method="post">
    <input type="hidden" name="userId" value="@ViewBag.UserId" />
    <div class="card" style="max-width:500px;">
        <div class="card-header">
            <h4>Quản lý quyền cho: <strong>@ViewBag.UserName</strong></h4>
        </div>
        <div class="card-body">
            @for (int i = 0; i < Model.Count; i++)
            {
                <div class="form-check m-2">
                    <input type="hidden" asp-for="@Model[i].RoleId" />
                    <input type="hidden" asp-for="@Model[i].RoleName" />
                    <input asp-for="@Model[i].Selected" class="form-check-input" />
                    <label class="form-check-label" asp-for="@Model[i].Selected">
                        @Model[i].RoleName
                    </label>
                </div>
            }
        </div>
        <div class="card-footer">
            <input type="submit" value="Cập nhật" class="btn btn-primary" />
            <a asp-action="Index" class="btn btn-secondary ms-2">Hủy</a>
        </div>
    </div>
</form>
