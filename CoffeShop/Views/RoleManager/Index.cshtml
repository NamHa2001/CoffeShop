@model List<Microsoft.AspNetCore.Identity.IdentityRole>
@{
    ViewData["Title"] = "Quản lý Role";
}

<h1>Quản lý Role</h1>

<form method="post" asp-action="AddRole" asp-controller="RoleManager">
    <div class="input-group mb-3" style="max-width:400px;">
        <input name="roleName" class="form-control" placeholder="Tên role mới..." />
        <button class="btn btn-info">Thêm Role</button>
    </div>
</form>

<table class="table table-striped">
    <thead>
        <tr>
            <th>Id</th>
            <th>Tên Role</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var role in Model)
        {
            <tr>
                <td>@role.Id</td>
                <td>@role.Name</td>
            </tr>
        }
    </tbody>
</table>
